src/App.js
import React, { Component } from "react";
import "./App.css";

// Class Component
class Header extends Component {
  render() {
    return (
      <div className="header">
        <h1>{this.props.name}</h1>
        <h3>{this.props.role}</h3>
        <p>{this.props.email} | {this.props.phone}</p>
      </div>
    );
  }
}

// Functional Component
function Section(props) {
  return (
    <div className="section">
      <h2>{props.title}</h2>
      {props.children}
    </div>
  );
}

// Main Functional Component
function App() {
  return (
    <div className="resume">

      <Header
        name="Musaib Parveez"
        role="Full Stack Developer"
        email="musaib@example.com"
        phone="+91 9876543210"
      />

      <Section title="Career Objective">
        <p>
          To obtain a challenging position where I can use my
          technical skills and contribute to organizational growth.
        </p>
      </Section>

      <Section title="Education">
        <p>MCA - RV College of Engineering</p>
        <p>Bachelor's Degree - University Name</p>
      </Section>

      <Section title="Technical Skills">
        <ul>
          <li>C++ and JavaScript</li>
          <li>HTML, CSS and React</li>
          <li>Node.js and Express</li>
          <li>MySQL and MongoDB</li>
        </ul>
      </Section>

      <Section title="Projects">
        <p><b>Online Book Cart:</b> A book management application.</p>
        <p><b>Portfolio Website:</b> A personal portfolio website.</p>
      </Section>

      <Section title="Personal Details">
        <p>Location: Bengaluru, India</p>
        <p>Languages: English, Hindi</p>
      </Section>

      <Section title="Declaration">
        <p>
          I hereby declare that the information provided above
          is true to the best of my knowledge.
        </p>
      </Section>

    </div>
  );
}

export default App;

src/App.css
.resume {
  max-width: 750px;
  margin: 30px auto;
  padding: 30px;
  background-color: white;
  color: #333;
  font-family: Arial, sans-serif;
  box-shadow: 0 0 10px #aaa;
}

.header {
  text-align: center;
  background-color: #243b55;
  color: white;
  padding: 20px;
  border-radius: 8px;
}

.header h1 {
  margin-bottom: 5px;
}

.header h3 {
