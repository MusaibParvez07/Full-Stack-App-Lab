// server.js
const express = require("express");
const path = require("path");

const app = express();

app.use(express.urlencoded({ extended: true }));

// Display the student form
app.get("/", (req, res) => {
    res.sendFile(path.join(__dirname, "index.html"));
});

// GET method
app.get("/student", (req, res) => {
    const name = req.query.name;
    const branch = req.query.branch;
    const semester = req.query.semester;

    res.send(`
        <html>
        <body style="background-color:lightyellow; font-family:Arial;">
            <h2>Student Information - GET Method</h2>
            <p>Name: <b>${name}</b></p>
            <p>Branch: <b>${branch}</b></p>
            <p>Semester: <b>${semester}</b></p>
            <a href="/">Go Back</a>
        </body>
        </html>
    `);
});

// POST method
app.post("/student", (req, res) => {
    const name = req.body.name;
    const branch = req.body.branch;
    const semester = req.body.semester;

    res.send(`
        <html>
        <body style="background-color:lightgreen; font-family:Arial;">
            <h2>Student Information - POST Method</h2>
            <p>Name: <b>${name}</b></p>
            <p>Branch: <b>${branch}</b></p>
            <p>Semester: <b>${semester}</b></p>
            <a href="/">Go Back</a>
        </body>
        </html>
    `);
});

app.listen(3000, () => {
    console.log("Server running at http://localhost:3000");
});

