const express = require("express");
const cors = require("cors");

const app = express();

app.use(cors());
app.use(express.json());

// Initial inventory data
let inventory = [
  { id: 1, productname: "product1", quantity: 12, price: 12 },
  { id: 2, productname: "product2", quantity: 1, price: 13 },
  { id: 3, productname: "product3", quantity: 10, price: 14 },
  { id: 4, productname: "product4", quantity: 19, price: 16 }
];

// GET API - Display all products
app.get("/", (req, res) => {
  res.json(inventory);
});

// POST API - Add a new product
app.post("/add", (req, res) => {
  const newProduct = {
    id: inventory.length + 1,
    productname: req.body.productname,
    quantity: Number(req.body.quantity),
    price: Number(req.body.price)
  };

  inventory.push(newProduct);

  res.json({
    message: "Product added successfully",
    product: newProduct
  });
});

// Start backend server
app.listen(8000, () => {
  console.log("Inventory server running on port 8000");
});

Run backend using: node myinventory.js

